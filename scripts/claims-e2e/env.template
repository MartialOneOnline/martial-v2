# Claims E2E — ISOLATED test environment. Copy to apps/web/.env.local IN A GIT WORKTREE
# (gitignored) and fill every <…>. Never production values:
# scripts/claims-e2e/guard.mjs refuses to continue if anything matches production.

# Supabase TEST project (Dashboard → Project Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://<test-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<test publishable key>
SUPABASE_SECRET_KEY=<test secret key>
# Pooler (transaction, port 6543) for the app; session/direct (5432) for migrations
DATABASE_URL=<test pooler connection string>
DIRECT_URL=<test direct or session-pooler connection string>

# Links in the emails must come back to this machine
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Dedicated, revocable Resend key for this test (sending access, martialapp.com domain)
RESEND_API_KEY=<dedicated test key>

# Random, test-only (generate: openssl rand -base64 32)
CLAIM_INVITE_SECRET=<random>

# Two DIFFERENT inboxes you control (plus-addressing is fine). Every email the dev server sends is limited to these two (scripts/claims-e2e/resend-allowlist.mjs).
E2E_ADMIN_EMAIL=<you+martial-admin@…>
E2E_OWNER_EMAIL=<you+martial-owner@…>
